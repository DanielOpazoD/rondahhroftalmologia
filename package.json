{
  "name": "hoja-atencion-oftalmologica",
  "version": "2.40.0",
  "private": true,
  "description": "Hoja de atención oftalmológica offline para rondas y operativos del Hospital Hanga Roa.",
  "type": "module",
  "imports": {
    "#especialidad/*": "./src/specialties/oftalmologia/*"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/dev-server.mjs",
    "test": "node --test \"tests/*.test.js\"",
    "test:stress": "SEMILLAS=200 node --test tests/convergence.test.js",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p jsconfig.json && tsc -p jsconfig.node.json && tsc -p jsconfig.sw.json",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test && npm run build",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-lines=97 --test-coverage-branches=91 --test-coverage-functions=92 \"tests/*.test.js\"",
    "deps": "node scripts/deps.mjs",
    "perf": "node scripts/perf.mjs",
    "calidad": "node scripts/calidad.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@types/node": "26.6.6",
    "esbuild": "0.28.2",
    "eslint": "10.15.0",
    "fake-indexeddb": "6.2.8",
    "globals": "17.14.0",
    "pdf-lib": "1.17.1",
    "prettier": "3.10.1",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@netlify/blobs": "11.1.9"
  }
}
